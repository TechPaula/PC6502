Name     clk_str;
PartNo   ;
Date     15/08/24;
Revision ;
Designer Shonky;
Company  ;
Assembly ;
Location ;
Device     f1504ispplcc44;

/*********************************************************
 *                     INPUT PINS                        *
 *********************************************************/

/* CPU Control Signals */
Pin 2  = CLK;
Pin 4  = RnW;
Pin 8  = !RESET;

/* Address Bus */
Pin 43 = A0;
Pin 9  = A4;
Pin 12 = A5;
Pin 14 = A6;
Pin 16 = A7;
Pin 17 = A8;
Pin 18 = A9;
Pin 19 = A10;
Pin 25 = A11;
Pin 20 = A12;
Pin 21 = A13;
Pin 24 = A14;
Pin 26 = A15;

/* 6850 Status Register */
Pin 1  = RXF;        /* BIT 0 of 6850 register */
Pin 44 = TXE;        /* BIT 1 of 6850 register */

/* Data Bus - for 6850 Register bits */
Pin 36 = D0;
Pin 34 = D1;

/* Clock Stretch Inputs */
Pin 6  = !SLOW1;
/* Next pin seems to be output only, thanks Microchip... */
/* Pin 11 = !SLOW0; */


/*********************************************************
 *                     OUTPUT PINS                       *
 *********************************************************/

/* CPU Control Signals */
Pin 5 = PHI2;
Pin 39 = !RD;
Pin 40 = !RW;

/* RAM CS And Bank Switching */
Pin 27 = RAM_A16;       /* spare RAM Address pin ready for BANKING memory if needed */
Pin 28 = RAM_A15;       /* spare RAM Address pin ready for BANKING memory if needed */
Pin 31 = !RAM_CS;

/* ROM Enables */
Pin 33 = !ROM_CS;
Pin 41 = !ROM_NR;

/* FT245 Enables */
Pin 29 = WR_FT;
Pin 37 = !RD_FT;






/*********************************************************
 *                        PINNODES                       *
 *********************************************************/

/* Clock Stretch Counter  (Q3 Renamed to PHI2) */
Pinnode = Q0;
Pinnode = Q1;
Pinnode = Q2;

/*********************************************************
 *                        VARIABLES                      *
 *********************************************************/




/*********************************************************
 *                     LOGIC EQUATIONS                   *
 *********************************************************/

/* Clock Stretching */
Q0.ar = RESET;
Q1.ar = RESET;
Q2.ar = RESET;
PHI2.ar = RESET;

Q0.ck = CLK;
Q1.ck = CLK;
Q2.ck = CLK;
PHI2.ck = CLK;

Q0.D = !PHI2
       # PHI2 & !Q0;

Q1.D = !PHI2 & !CONSOLE_CS
       # PHI2 & !Q1 & Q0
       # PHI2 & Q1 & !Q0;

Q2.D = !PHI2 & SLOW1
       # PHI2 & Q2 & !Q1
       # PHI2 & Q2 & !Q0   
       # PHI2 & !Q2 & Q1 & Q0;

PHI2.D = !PHI2
       # PHI2 & !Q2  
       # PHI2 & !Q1
       # PHI2 & !Q0  
       # !PHI2 & Q2 & Q1 & Q0;



/* Address Decoding (Grant Searle Memory Map) */
/* ROM 0xC000 - 0xFFFF */
ROM_CS = A15 & A14; 

/* RAM 0x0000 - 0x7FFF */        
RAM_CS = !A15; 

/* Serial port 0xA000 - 0xA00F */         
CONSOLE_CS = A15 & !A14 & A13 & !A12 & !A11 & !A10 & !A9 & !A8 & !A7 & !A6 & !A5 & !A4;

/* Read/Write */
RW = PHI2 & !RnW;
RD = PHI2 & RnW;

/* RAM Banking Bits, For Future Use so force low */
RAM_A15 = 'b'0;
RAM_A16 = 'b'0;

/* ROM Enable */
ROM_NR = RD;

/* FT245 Read/Write Enables */
RD_FT = PHI2 & CONSOLE_CS & A0 &  RnW;    /* 0xA001 */
WR_FT = PHI2 & CONSOLE_CS & A0 & !RnW;    /* 0xA001 */ 

/* FT245 Faked 6850 Status "Register" */
D0 = !RXF;           
D1 = !TXE;        
D0.oe = CONSOLE_CS & !A0 & RnW;        /* 0xA000 */
D1.oe = CONSOLE_CS & !A0 & RnW;        /* 0xA000 */



/* END OF FILE */
/*****************************************************/