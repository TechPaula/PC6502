Name     PC6502_CPU;
PartNo   ;
Date     2025;
Revision ;
Designer PaulaMaddox;
Company  ;
Assembly ;
Location ;
Device	f1502ispplcc44;

/*****************************************************/
/* Inputs */

pin 43  = A0;
pin 11 = !SLOW0;
pin 6  = !SLOW1;
pin 8  = !RESET;
pin 9  = A4;
pin 12 = A5;
pin 14 = A6;
pin 16 = A7;
pin 17 = A8;
pin 18 = A9;
pin 19 = A10;
pin 25 = A11;
pin 20 = A12;
pin 21 = A13;
pin 24 = A14;
pin 26 = A15;

pin 1  = RXF;			/* BIT 0 of 6850 register */
pin 44 = TXE;			/* BIT 1 of 6850 register */

pin 4  = RnW;
pin 2  = CLK;				/* System clock */

/*****************************************************/
/* Outputs */

pin 40 = !RW;
pin 39 = !RD;

pin 41 = !ROM_NR;
pin 33 = !ROM_CS;
pin 31 = !RAM_CS;

pin 28 = RAM_A15;			/* spare RAM Address pin ready for BANKING memory if needed */
pin 27 = RAM_A16;			/* spare RAM Address pin ready for BANKING memory if needed */

pin 37 = !RD_FT;
pin 29 = !WR_FT;

pin 5 = CPU_CLK;

/*****************************************************/
/* Input / output pins */
pin 36 = D0;		
pin 34 = D1;


/*****************************************************/
/* PINNODEs i.e. internal signals */

PINNODE = CONSOLE_CS;
PINNODE = DLY_CLK;




/*****************************************************/
/* Address Decode */

/* Grant Searle memory map */
ROM_CS = A15 & A14; 				/* ROM 0xC000 - 0xFFFF */
RAM_CS = !A15;						/* RAM 0x0000 - 0x7FFF */
CONSOLE_CS = A15 & !A14 & A13 & !A12 & !A11 & !A10 & !A9 & !A8 & !A7 & !A6 & !A5 & !A4; /* Serial port 0xA000 - 0xA00F */


/*****************************************************/
/* CPU Clock Generation */

CPU_CLK.ar = RESET;
CPU_CLK.sp = 'b'0;
CPU_CLK.d = !CPU_CLK;
CPU_CLK.ck = CLK;


/*****************************************************/
/* Logic Equations */



RW = CPU_CLK & !RnW;
RD = CPU_CLK & RnW;

RAM_A15 = 'b'0;
RAM_A16 = 'b'0;

ROM_NR = RD;



DLY_CLK = CPU_CLK & !CLK;		/* this gives me an actvie clock on second half of CPU clock */

/* FT245 bits */

RD_FT = DLY_CLK & CONSOLE_CS & A0 &  RnW;		/* 0xA000 - 0xAFFF */
WR_FT = DLY_CLK & CONSOLE_CS & A0 & !RnW;		/* 0xA000 - 0xAFFF */ 

D0 = !RXF;				
D1 = !TXE;			
D0.oe = CPU_CLK & CONSOLE_CS & !A0 & RnW; 
D1.oe = CPU_CLK & CONSOLE_CS & !A0 & RnW; 



/*
RD_FT = DLY_CLK & A15 & !A14 & A13 & !A12 & A0 &  RnW;		/* 0xA000 - 0xAFFF */
WR_FT = DLY_CLK & A15 & !A14 & A13 & !A12 & A0 & !RnW;		/* 0xA000 - 0xAFFF */ 

D0 = !RXF;				
D1 = !TXE;			
D0.oe = CPU_CLK & A15 & !A14 & A13 & !A12 & !A0 & RnW; 
D1.oe = CPU_CLK & A15 & !A14 & A13 & !A12 & !A0 & RnW; 
*/


/* END OF FILE */
/*****************************************************/