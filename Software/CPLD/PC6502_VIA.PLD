Name     PC6502_VIA;
PartNo   ;
Date     2025;
Revision ;
Designer PaulaMaddox;
Company  ;
Assembly ;
Location ;
Device	f1502ispplcc44;

/*****************************************************/
/* Inputs */

pin 8  = !RESET;
pin 9  = A4;
pin 12 = A5;
pin 14 = A6;
pin 16 = A7;
pin 17 = A8;
pin 18 = A9;
pin 19 = A10;
pin 25 = A11;
pin 20 = A12;
pin 21 = A13;
pin 24 = A14;
pin 26 = A15;

pin 4  = RnW;
pin 2  = SYS_CLK;				/* System clock */
pin 41 = CPU_CLK;

pin 5  = !VIASEL0;
pin 11 = !VIASEL1;
pin 6  = !VIASEL2;
pin 39 = !VIASEL3;


/*****************************************************/
/* Outputs */

pin 33 = !VIA_nCS;
pin 28 = !VIA_LED;

pin 40 = VIA_CLK;

/*****************************************************/
/* Pinnodes */

PINNODE = VIA1;
PINNODE = VIA2;
PINNODE = VIA3;
PINNODE = VIA4;




/*****************************************************/
/* spares */

/*****************************************************/
/* Address Decode */


VIA_nCS = A15 & !A14 & A13 & !A12 & !A11 & !A10  & !A9  & !A8 & A7 & (VIA1 # VIA2 # VIA3 # VIA4);	/* 0xA080 -> */
VIA_LED = VIA_nCS;



/*****************************************************/
/* VIA CLK */

/*
VIA_CLK.ar = RESET;
VIA_CLK.ck = CLK;
VIA_CLK.d = !VIA_CLK;
*/

VIA_CLK = SYS_CLK;


/*****************************************************/
/* Logic Equations */

VIA1 = VIASEL0 & !A5 & !A4;		/* BASE ADDRESS = 0xA080 */
VIA2 = VIASEL1 & !A5 &  A4;		/* BASE ADDRESS = 0xA090 */
VIA3 = VIASEL2 &  A5 & !A4;       /* BASE ADDRESS = 0xA0A0 */
VIA4 = VIASEL3 &  A5 &  A4;		/* BASE ADDRESS = 0xA0B0 */







/* END OF FILE */
/*****************************************************/