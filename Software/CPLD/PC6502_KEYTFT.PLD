Name     PC6502_KEYTFT;
PartNo   ;
Date     2025-11-29;
Revision ;
Designer Paula;
Company  ;
Assembly ;
Location ;
Device	  f1502ispplcc44;

/*********************************************************
 *                     INPUT PINS                        *
 *********************************************************/

/* CPU Control Signals */
Pin 2  = SYSCLK;
Pin 4  = RnW;
Pin 8  = !nRES;
Pin 43 = CPU_CLK;

/* Address Bus */
Pin 9  = A4;
Pin 12 = A5;
Pin 14 = A6;
Pin 16 = A7;
Pin 17 = A8;
Pin 18 = A9;
Pin 19 = A10;
Pin 25 = A11;
Pin 20 = A12;
Pin 21 = A13;
Pin 24 = A14;
Pin 26 = A15;

/* display outputs */
Pin 1  = !DISP_nWAIT;
Pin 44 = !DISP_nINT;    /* not needed as we don't have resistive touch */

/*********************************************************
 *                     OUTPUT PINS                       *
 *********************************************************/

/* Clock Stretch Outputs */
Pin 28 = !nSLOW0;
Pin 27 = !nSLOW1;

/* Chip select outputs */
Pin 31 = !KEY_nCS;
Pin 29 = !DISP_nCS;

/* Display outputs */
Pin 40 = BL;
Pin 39 = DISP_EN;        /* RA8875 calls this #RD */
Pin 37 = !DISP_nRES;

Pin 33 = TXS_OE;     /* TEST POINT, reused */

/*********************************************************
 *              INPUT/OUTPUT PINS                        *
 *********************************************************/

/* data bus input/outputs */
Pin 41 = D0;
Pin 36 = D1;
Pin 34 = D2;

/*********************************************************
 *                        PINNODES                       *
 *********************************************************/

PINNODE = COUNT0;
PINNODE = COUNT1;




/*********************************************************
 *                        COUNTERS                       *
 *********************************************************/

COUNT0.T = 'b'1;
COUNT0.CK = SYSCLK;
COUNT0.AR = !DISP_nCS # nRES;
/*COUNT0.AR = !DISP_nCS # !CPU_CLK # nRES;*/    /* USE WITH CLOCK STRETCHING */




/*********************************************************
 *                     LOGIC EQUATIONS                   *
 *********************************************************/


/* Keyboard Serial port 0xA330 - 0xA33F */			
KEY_nCS     = A15 & !A14 & A13 & !A12 & !A11 & !A10 & A9 & A8 & !A7 & !A6 & A5 &  A4;

/* Display parts, address 0xA320-0xA32F*/
DISP_nCS   = A15 & !A14 & A13 & !A12 & !A11 & !A10 & A9 & A8 & !A7 & !A6 & A5 & !A4;
DISP_nRES = nRES;
TXS_OE = DISP_nCS;

/*DISP_EN = COUNT0 & !SYSCLK;*/    /*Should work for > 8MHz, but doesn't */
DISP_EN = DISP_nCS & SYSCLK;       /*Use this if running <= 8MHz CPU CLK */

/*nSLOW0 = DISP_nCS # KEY_nCS;*/   /*Should work for > 8MHz, but doesn't */
nSLOW0 = KEY_nCS;                  /*Use this if running <= 8MHz CPU CLK */
/*nSLOW1 = DISP_nCS;*/             /*Should work for > 8MHz, but doesn't */

BL = 'b'1;



/* END OF FILE */
/*****************************************************/
