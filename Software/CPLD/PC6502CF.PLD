Name     PC6502CF;
PartNo   ;
Date     19/10/25;
Revision ;
Designer Shonky;
Company  ;
Assembly ;
Location ;
Device	  f1502ispplcc44;

/*********************************************************
 *                     INPUT PINS                        *
 *********************************************************/

/* CPU Control Signals */
Pin 2  = SYS_CLK;
Pin 4  = RnW;
Pin 8  = !RESET;
Pin 43 = CPU_CLK;
/* Address Bus */

Pin 9  = A4;
Pin 12 = A5;
Pin 14 = A6;
Pin 16 = A7;
Pin 17 = A8;
Pin 18 = A9;
Pin 19 = A10;
Pin 25 = A11;
Pin 20 = A12;
Pin 21 = A13;
Pin 24 = A14;
Pin 26 = A15;


/*********************************************************
 *                     OUTPUT PINS                       *
 *********************************************************/

/* CPU Control Signals */
Pin 39 = CF_RD;
Pin 40 = CF_WR;

/* RAM CS And Bank Switching */
Pin 33 = CF_CS;

/* ROM Enables */
Pin 31 = CF_RST;

Pin 28 = CF_LED;




/*********************************************************
 *                        PINNODES                       *
 *********************************************************/

/*********************************************************
 *                        VARIABLES                      *
 *********************************************************/




/*********************************************************
 *                     LOGIC EQUATIONS                   *
 *********************************************************/

!CF_CS = A15 & !A14 & A13 & !A12 & !A11 & !A10 & A9 & !A8 & !A7 & !A6 & !A5 & !A4;

!CF_RD = CPU_CLK & !CF_CS & RnW;

!CF_WR = CPU_CLK & !CF_CS & !RnW;

!CF_LED = !CF_CS;

!CF_RST = RESET;



