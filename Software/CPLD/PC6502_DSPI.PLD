Name     PC6502_DSPI;
PartNo   ;
Date     2025;
Revision ;
Designer PaulaMaddox;
Company  ;
Assembly ;
Location ;
Device	f1502ispplcc44;

/*****************************************************/
/* Inputs */

pin 9  = A4;
pin 12 = A5;
pin 14 = A6;
pin 16 = A7;
pin 17 = A8;
pin 18 = A9;
pin 19 = A10;
pin 25 = A11;
pin 20 = A12;
pin 21 = A13;
pin 24 = A14;
pin 26 = A15;

/*pin 36 = D0;*/				/* spare data bus input */
/*pin 34 = D1;*/				/* spare data bus input */

pin 4  = RnW;
pin 2  = SYS_CLK;				/* System clock */
pin 41 = CPU_CLK;
pin 8 = !RESET;

/*****************************************************/
/* Outputs */

pin 36 = CLK_A;
pin 34 = CLK_B;

pin 28 = !SPI1_LED;
pin 27 = !SPI2_LED;

pin 33 = !SPI1_CS;
pin 31 = !SPI2_CS;

/*****************************************************/
/* PINNODES */
pinnode = Q0_SPI1;
pinnode = Q0_SPI2;

/*****************************************************/
/* Address Decode */

SPI1_CS = A15 & !A14 & A13 & !A12 & !A11 & !A10 & !A9 & !A8 & A7 & A6 & !A5 & !A4;	
SPI2_CS = A15 & !A14 & A13 & !A12 & !A11 & !A10 & !A9 & !A8 & A7 & A6 & !A5 &  A4;

SPI1_LED = SPI1_CS;
SPI2_LED = SPI2_CS;


/*****************************************************/
/* Clock generation */

/* CLK_A is 1/4 of SYSCLK */

Q0_SPI1.ar = RESET;
Q0_SPI1.ck = SYS_CLK;
Q0_SPI1.d = !Q0_SPI1;

CLK_A.ar = RESET;
CLK_A.ck = SYS_CLK;
CLK_A.D = CLK_A & !Q0_SPI1
	   # !CLK_A & Q0_SPI1;


/* CLK_B is 1/4 of CPU_CLK */
Q0_SPI2.ar = RESET;
Q0_SPI2.ck = CPU_CLK;
Q0_SPI2.d = !Q0_SPI2;

CLK_B.ar = RESET;
CLK_B.ck = CPU_CLK;
CLK_B.D = CLK_B & !Q0_SPI2
	   # !CLK_B & Q0_SPI2;




/* END OF FILE */
/*****************************************************/