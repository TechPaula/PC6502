5026 GOSUB 3300

5030 PX = CX
5032 PY = CY
5034 PC = %11100000
5036 GOSUB 3300

5040 CN = 2
5042 DX = 0
5044 DY = 0


5100 REM LOOP
5102 FOR LP = 0 TO 9999
5105 PRINT LP,CN,

5108 IF CN < 2 GOTO 5200
5110 REM MUST BE CORNER 2 (270,270)
5120 PC = %11100000
5130 IF DX > CX THEN GOTO 5140
5132 TD = CX - DX
5134 TD = INT(TD / 2)
5136 DX = DX + TD
5138 GOTO 5150 

5140 TD = CX - DX
5142 TD = INT(TD / 2)
5144 DX = DX - TD

5150 IF DY > CY THEN GOTO 5160
5152 TD = CY - DY
5154 TD = INT(TD / 2)
5156 DY = DY + TD
5158 GOTO 5199

5160 TD = CY - DY
5162 TD = INT(TD / 2)
5164 DY = DY + TD
5199 GOTO 5400

5200 IF CN < 1 GOTO 5300
5201 REM MUST BE CORNER 1 (0,270)
5220 PC = %00011100

5230 IF DX > BX THEN GOTO 5240
5232 TD = BX - DX
5234 TD = INT(TD / 2)
5236 DX = DX + TD
5238 GOTO 5250

5240 TD = BX - DX
5242 TD = INT(TD / 2)
5244 DX = DX + TD

5250 IF DY > BY THEN GOTO 5260
5252 TD = BY - DY
5254 TD = INT(TD / 2)
5256 DY = DY + TD
5258 GOTO 5299

5260 TD = BY - DY
5262 TD = INT(TD / 2)
5264 DY = DY + TD
5299 GOTO 5400


5300 REM MUST BE CORNER 0 (0,0)
5320 PC = %00000011
5330 IF DX > AX THEN GOTO 5340
5332 TD = AX - DX
5334 TD = INT(TD / 2)
5336 DX = DX + TD
5338 GOTO 5350

5340 TD = AX - DX
5342 TD = INT(TD / 2)
5344 DX = DX + TD

5350 IF DY > AY THEN GOTO 5360
5352 TD = AY - DY
5354 TD = INT(TD / 2)
5356 DY = DY + TD
5358 GOTO 5400

5360 TD = AY - DY
5362 TD = INT(TD / 2)
5364 DY = DY + TD



5400 REM PLOT THE NEW POINT 
5402 PX = DX
5404 PY = DY
5408 GOSUB 3300

5450 CN = INT(RND(0)*3)
5500 NEXT LP

5999 RETURN


