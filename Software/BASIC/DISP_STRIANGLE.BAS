3300 REM -- DRAW SQUARE
3301 REM USING PX, PY AND PC

3302 PRINT PX, : PRINT PY, : PRINT PC

3304 REM YT AND XT HOLD OTHER CORNER
3305 REM HT AND WD ARE HEIGHT AND WIDTH
3307 YT = HT + PY - 1
3308 XT = WD + PX - 1

3310 XM = PX >> 8
3312 TD = XM * 256
3313 XL = PX - TD

3320 YM = PY >> 8
3322 TD = YM * 256
3323 YL = PY - TD

3330 POKE RG,$91
3335 POKE DT,XL
3340 POKE RG,$92
3345 POKE DT,XM
3350 POKE RG,$93
3355 POKE DT,YL
3360 POKE RG,$94
3365 POKE DT,YM

3368 HM = YT >> 8
3369 TD = HM * 256
3370 HL = YT - TD

3371 WM = XT >> 8
3372 TD = WM * 256
3373 WL = XT - TD


3374 POKE RG,$95
3375 POKE DT,WL
3380 POKE RG,$96
3385 POKE DT,WM
3390 POKE RG,$97
3395 POKE DT,HL
3400 POKE RG,$98
3405 POKE DT,HM


3410 REM - SPLIT COLOURS
3420 PR = PC >> 5
3422 TD = PR * 32
3424 PG = PC - TD
3426 PG = PG >> 2
3428 TD = PC >> 2
3430 TD = TD * 4
3432 PB = PC - TD

3440 POKE RG,$63
3445 POKE DT,PR
3450 POKE RG,$64
3455 POKE DT,PG
3460 POKE RG,$65
3465 POKE DT,PB

3470 POKE RG,$90
3471 POKE DT,$90
3480 TD = PEEK(DT)
3483 IF TD > 127 THEN GOTO 3480
3499 RETURN



5000 REM -- TRIANGLE GASKET
5005 PRINT "SIERPINSKI TRIANGLE"

5007 HT = 2
5008 WD = 2

5010 PX = AX
5012 PY = AY
5014 PC = %00000011
5016 GOSUB 3300

5020 PX = BX
5022 PY = BY
