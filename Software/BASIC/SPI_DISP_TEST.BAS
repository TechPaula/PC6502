10 REM ------------------------------
11 REM TEST OF TFT DISPLAY VIA SPI

20 ST = 0         : REM STATUS BYTE
25 CM = 0         : REM COMMAND BYTE
30 DT = 0         : REM DATA BYTE 

100 REM SETUP SPI
101 SB = $A0C0      : REM SPI0 DATA IN/OUT
102 SC = SB + 1     : REM SPI0 STATUS/CONTROL
103 SS = SB + 2     : REM SLAVE SELECT
104 SR = 0          : REM VALUE OF DATA FROM SPI STATUS REGISTER
115 POKE SS,$FF

120 REM SETUP VIA 
121 VB = $A080   : REM VIA-A BASE ADDRESS
122 PB = VB      : REM PORT B IN/OUT ADDRESS
123 PA = VB+1    : REM PORT A IN/OUT ADDRESS
124 DB = VB+2    : REM PORT B DIRECTION REGISTER
125 DA = VB+3    : REM PORT A DIRECTION REGISTER
130 POKE DB,%00001111  : REM UPPER 4 BITS INPUT, LOWER OUTPUT
131 POKE PB,%00001111



1000 REM ----------------------------
1001 REM START OF TEST CODE

1005 GOSUB 9950
1006 POKE PB,%00000000
1007 GOSUB 9950
1008 POKE PB,%00001111
1009 GOSUB 9950

1010 GOSUB 9000
1015 PRINT HEX$(ST)



8989 END
8990 PRINT "NO DISPLAY"
8999 END







9000 REM ----------------------------
9001 REM READ STATUS BYTE

9010 POKE SS,$FE    : REM SS LOW
9015 POKE SB,$C0    : REM SEND STATUS INSTRUCTION
9020 GOSUB 9900     : REM WAIT FOR IT TO COMPLETE SENDING
9025 POKE SB,$00
9026 GOSUB 9900
9030 ST = PEEK(SB)  : REM GET STATUS
9035 POKE SS,$FF    : REM SS HIGH
9040 RETURN




9900 REM ----------------------------
9901 REM CHECK STATUS OF SPI
9902 SR = PEEK(SC)
9905 IF SR = 64 THEN GOTO 9902
9910 RETURN


9950 REM ----------------------------
9951 REM DELAY
9955 FOR DL = 0 TO 500
9956 NEXT DL
9960 RETURN
