5000 REM -- MANDLEBROT
5005 PRINT "DRAW MANDLEBROT SET"
5010 FOR Y=-105 TO 105
5020 FOR X=-80 TO 40
5030 CA= X*0.02611
5040 CB= Y*0.01305
5050 A=CA
5060 B=CB
5070 FOR I=0 TO 15
5080 T=A*A-B*B+CA
5090 B=2*A*B+CB
5100 A=T
5110 IF (A*A+B*B)>4 THEN GOTO 5200
5120 NEXT I
5130 PRINT " ";
5131 PC = $00
5132 GOSUB 3100    : REM DRAW PIXEL
5140 GOTO 5210
5200 PC = 255-((I+1)*15)  :REM NICE SET OF COLOURS
5202 GOSUB 3100
5203 IF I>9 THEN I=I+7
5205 PRINT CHR$(48+I);
5210 PX = PX + 2
5220 NEXT X
5230 PY = PY + 1
5235 PX = $20
5236 PRINT ""
5240 NEXT Y
5299 RETURN


