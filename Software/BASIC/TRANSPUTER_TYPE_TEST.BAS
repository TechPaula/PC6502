10 REM --- TRANSPUTER WRITE & READ TEST
11 REM -- WRITES $DEADBEEF TO $80000100
12 REM -- THEN READS IT BACK
13 REM -- AND THEN SENDS A PROGRAM TO GET 
14 REM -- THE TYPE OF TRANSPUTER

15 RESTORE

20 BS = $A340
25 IS = BS + 2   : REM INPUT STATUS
30 OS = BS + 3   : REM OUTPUT STATUS
35 DT = BS + 1   : REM DATA OUT (CAN'T USE DO)
40 DI = BS       : REM DATA IN
45 RS = BS + 6   : REM RESET CONTROL
50 AN = BS + 7   : REM ANALYSE CONTROL
55 ER = BS + 5   : REM ERROR STATUS (NOT YET IMPLEMENTD IN CPLD)


80 REM -- WRITE DATA TO TRAM AT $80000000
81 DATA $00,$00,$00,$00,$80,$DE,$AD,$BE,$EF

85 REM -- SEND READ TO TRAM FROM $80000000
86 DATA $01,$00,$00,$00,$80

91 REM -- TRANSPUTER TEST PROGRAM
92 DATA 23,177,209,36,242,33,252,36,242,33,248
93 DATA 240,96,92,42,42,42,74,255,33,47,255,2,0

100 PRINT "SET ANALYSE HIGH"
105 POKE AN,$00
110 PRINT "RESET C011 AND TRAM (HIGH)"
115 POKE RS,$FF
120 FOR DL = 0 TO 500
125 NEXT DL
130 PRINT "RESET C011 AND TRAM (LOW)"
135 POKE RS,$00
140 PRINT "SET ANALYSE LOW"
145 POKE AN,$FF

170 GOSUB 1000
180 GOSUB 1100
190 GOSUB 2000

200 PRINT "SET INPUT STATUS TO $00"
210 POKE IS,$00
220 GOSUB 2000

300 PRINT "SET OUTPUT STATUS TO $00"
310 POKE OS,$00
320 GOSUB 2000

400 GOSUB 1000
410 GOSUB 1100
420 GOSUB 2000

498 PRINT "SENDING TEST DATA"
499 REM -- SEND TEST BYTE "$DEADBEEF" TO TRAM
500 FOR LP = 0 TO 8
502 GOSUB 1100

504 READ TP
505 PRINT ">> SEND $";
506 PRINT HEX$(TP,2)
510 POKE DT,TP

590 NEXT LP

600 REM -- READ DATA FROM TRANSPUTER
605 PRINT "SENDING READ + ADDRESS ";
610 FOR LP = 0 TO 4
620 READ TP
625 PRINT HEX$(TP,2);
626 PRINT ",";
630 POKE DT,TP
640 NEXT LP
645 PRINT ""

647 PRINT "READ DATA"
650 FOR LP = 0 TO 3
660 GOSUB 1000
670 GOSUB 1200
680 NEXT LP

700 REM -- TRANSPUTER TEST PROGRAM
701 REM -- FROM https://www.geekdot.com/1st-code-example/
705 PRINT "SENDING PROGRAM "
710 FOR X=1 TO 24
715 GOSUB 1100
720 READ T
730 POKE DI,T
735 PRINT ">> SEND ";
736 PRINT T

740 NEXT X
750 PRINT
755 PRINT"READING RESULT:"

770 TP = PEEK(IS)
775 PRINT ".";
780 IF TP = 0 THEN GOTO 770

800 FOR LP = 0 TO 3
810 GOSUB 1000
820 GOSUB 1200
830 NEXT LP




999 END

1000 REM ---
1010 PRINT "INPUT STATUS =";
1015 TP = PEEK(IS)
1020 PRINT HEX$(TP,2)
1030 RETURN

1100 REM ---
1110 PRINT "OUTPUT STATUS =";
1115 TP = PEEK(OS)
1120 PRINT HEX$(TP,2)
1130 RETURN

1200 REM ---
1210 PRINT "<< READ =$";
1220 TP = PEEK(DI)
1230 PRINT HEX$(TP,2)
1240 RETURN

