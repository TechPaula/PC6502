 6 REM * SETS UP AND PLAYS NOTES ON YM262F CHIP ON PC6502 STACK *


 10 DIM RG(32)
 20 DIM IN(32)
 30 DIM NL(64)
 40 DIM NH(64)
 50 LET B = 0
 90 RESTORE


100 REM **** SAY TWINKLE TWINKLE LITTLE STAR ****
105 LET SP = 41216
106 LET RS = 41217

109 PRINT "ASSERT RESET ON SP0256"
110 POKE RS, 0
115 FOR D = 0 TO 500
116 NEXT D
117 POKE RS, 3
119 PRINT "DE-ASSERT RESET ON SP0256"
120 FOR D = 0 TO 500
121 NEXT D

130 FOR T = 0 TO 27
140 READ AL
150 POKE SP,AL
160 PRINT AL;

170 LET LQ = PEEK(RS) 
180 IF LQ > 161 THEN GOTO 170
190 NEXT T
195 PRINT " "


 200 REM -- LOAD REGISTERS INTO ARRAY --
 210 PRINT "LOAD REGISTER ARRAY"
 230 FOR T = 0 TO 10
 240 READ RG(T)
 250 REM PRINT RG(T);
 260 NEXT T
 270 PRINT ""

 300 REM -- LOAD INSTRUMENT INTO ARRAY --
 310 PRINT "LOAD INSTRUMENT ARRAY"
 330 FOR T = 0 TO 10
 340 READ IN(T)
 350 REM PRINT IN(T);
 360 NEXT T
 370 PRINT ""

 400 REM -- LOAD SCALED INTO ARRAY --
 410 PRINT "LOAD MELODY"
 420 FOR T = 0 TO 41
 440 READ NL(T), NH(T)
 450 REM PRINT NL(T);
 455 REM PRINT NH(T)
 460 NEXT T
 470 PRINT ""


 2000 REM -- LOAD DATA INTO YMF262 --
 2010 FOR T = 0 TO 10
 2020 PRINT "LOAD SOUND INTO YMF262"
 2040 FOR T = 0 TO 10
 2050 POKE 41232, RG(T)
 2060 POKE 41233, IN(T)
 2070 BY = RG(T)
 2080 GOSUB 9000
 2085 PRINT "0x";
 2090 PRINT B$;
 2100 BY = IN(T)
 2110 GOSUB 9000
 2115 PRINT " 0x";
 2120 PRINT B$
 2150 NEXT T
 2160 PRINT ""


 3000 REM -- PLAY NOTES --
 3005 FOR L = 0 TO 5
 3010 FOR T = 0 TO 6
 3020 PRINT "PLAYING NOTE";
 3030 PRINT T+B; 
 3035 PRINT ":";
 3045 REM REGISTER NUMBER (192, $A0)
 3040 POKE 41232, 160
 3050 POKE 41233, NL(T+B)
 3055 PRINT NL(T+B);
 3060 LET KY = NH(T+B) OR 48
 3070 POKE 41232, 176
 3080 POKE 41233, KY
 3085 PRINT KY;
 3100 GOSUB 5000

 3110 POKE 41232, 176
 3120 LET KY = NH(T+B) OR 16
 3130 POKE 41233, KY
 3140 PRINT KY
 3150 GOSUB 5000
 
 3160 NEXT T
 3170 GOSUB 5000
 3175 GOSUB 5000
 3180 LET B = B + 7
 3190 NEXT L



 4999 END


