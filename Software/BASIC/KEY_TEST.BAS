10 REM -- 6551 KEYBOARD TEST
100 AC = $A330
110 DT = AC
120 ST = AC + 1
130 CM = AC + 2
140 CT = AC + 3
150 CH = $30

199 REM ---------------------
200 POKE ST,$00    : REM DO RESET
210 TP = PEEK(ST)
212 PRINT "STATUS : 0b";
215 PRINT BIN$(TP,8)

220 POKE CM,%00001011
222 PRINT "COMMAND: 0b";
230 TP = PEEK(CM)
235 PRINT BIN$(TP,8)

240 POKE CT,%00010000
250 TP = PEEK(CT)
252 PRINT "CONTROL: 0b";
255 PRINT BIN$(TP,8)


499 REM ---------------------
500 REM MAIN LOOP
510 TP = PEEK(ST)

512 IF TP < %00011000 THEN GOTO 600

514 PRINT ""
515 PRINT "ST: 0b";
520 PRINT BIN$(TP,8);


550 TP = PEEK(DT)
555 PRINT "  RX DATA: 0x";
560 PRINT HEX$(TP,2);
570 PRINT "     CHAR: ";
585 PRINT CHR$(TP)

600 PRINT ".";
610 POKE DT,CH
615 CH = CH + 1
620 IF CH < $3A THEN GOTO 650
630 CH = $30

650 GOSUB 2000


800 GOTO 500


1999 REM -------------------
2000 REM DELAY
2010 FOR T= 0 TO 1000
2020 NEXT T
2030 RETURN
