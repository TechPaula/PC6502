10 REM --- TRANSPUTER WRITE & READ TEST
11 REM -- WRITES $DEADBEEF TO $80000100
12 REM -- THE READS IT BACK

20 BS = $A340
25 IS = BS + 2   : REM INPUT STATUS
30 OS = BS + 3   : REM OUTPUT STATUS
35 DT = BS + 1   : REM DATA OUT (CAN'T USE DO)
40 DI = BS       : REM DATA IN
45 RS = BS + 6   : REM RESET CONTROL
50 AN = BS + 7   : REM ANALYSE CONTROL
55 ER = BS + 5   : REM ERROR STATUS (NOT YET IMPLEMENTD IN CPLD)


90 REM -- WRITE DATA TO TRAM AT $80000000
91 DATA $00,$00,$00,$00,$80,$DE,$AD,$BE,$EF

95 REM -- SEND READ TO TRAM FROM $80000000
96 DATA $01,$00,$00,$00,$80

100 PRINT "SET ANALYSE HIGH"
105 POKE AN,$00
110 PRINT "RESET C011 AND TRAM (HIGH)"
115 POKE RS,$FF
120 FOR DL = 0 TO 100
125 NEXT DL
130 PRINT "RESET C011 AND TRAM (LOW)"
135 POKE RS,$00
140 PRINT "SET ANALYSE LOW"
145 POKE AN,$FF

170 GOSUB 1000
180 GOSUB 1100
190 GOSUB 2000

200 PRINT "SET INPUT STATUS TO $00"
210 POKE IS,$00
220 GOSUB 2000

300 PRINT "SET OUTPUT STATUS TO $00"
310 POKE OS,$00
320 GOSUB 2000

400 GOSUB 1000
410 GOSUB 1100
420 GOSUB 2000

498 PRINT "SENDING TEST DATA"
499 REM -- SEND TEST BYTE "$DEADBEEF" TO TRAM
500 FOR LP = 0 TO 8
502 GOSUB 1100

504 READ TP
505 PRINT ">> SEND $";
506 PRINT HEX$(TP,2)
510 POKE DT,TP

590 NEXT LP




600 REM -- READ DATA FROM TRANSPUTER
605 PRINT "SENDING READ + ADDRESS ";
610 FOR LP = 0 TO 4
620 READ TP
625 PRINT HEX$(TP,2);
626 PRINT ",";
630 POKE DT,TP
640 NEXT LP
645 PRINT ""

647 PRINT "READ DATA"
650 FOR LP = 0 TO 3
660 GOSUB 1000
670 GOSUB 1200
680 NEXT LP





999 END

1000 REM ---
1010 PRINT "INPUT STATUS =";
1015 TP = PEEK($A342)
1020 PRINT HEX$(TP,2)
1030 RETURN

1100 REM ---
1110 PRINT "OUTPUT STATUS =";
1115 TP = PEEK($A343)
1120 PRINT HEX$(TP,2)
1130 RETURN

1200 REM ---
1210 PRINT "<< READ =$";
1220 TP = PEEK(DI)
1230 PRINT HEX$(TP,2)
1240 RETURN

2000 REM --
2010 FOR DL = 0 TO 100
2015 NEXT DL
2020 RETURN


